# API key for the OpenAI-compatible endpoint, e.g. from https://build.nvidia.com
NVIDIA_API_KEY=nvapi-REPLACE_ME

# OpenAI-compatible endpoint. Hosted by default; use http://localhost:8000/v1 for a self-hosted NIM or vLLM.
NIM_BASE_URL=https://integrate.api.nvidia.com/v1

# Model used for criterion parsing and assessment
CTM_MODEL_FAST=nvidia/nemotron-3.5-lightning-30b-a3b
CTM_TEMPERATURE=0.2
# Default output token limit per call
CTM_MAX_TOKENS=4096
